// Shale Linux default: the Shale logo (made by tools/make-fastfetch-logo.py).
// Copy this file to ~/.config/fastfetch/config.jsonc to customise it.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "/etc/xdg/fastfetch/shale-logo.txt",
        "width": 32,
        "height": 16,
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "color": { "keys": "#8a9bb0", "title": "#c3cfdc" }
    },
    "modules": [
        "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
        "display", "de", "wm", "theme", "icons", "font", "terminal", "cpu", "gpu",
        "memory", "swap", "disk", "localip", "battery", "poweradapter", "locale",
        "break", "colors"
    ]
}
