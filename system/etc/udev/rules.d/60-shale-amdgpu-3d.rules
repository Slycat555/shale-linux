# AMD GPUs use the 3D_FULL_SCREEN power profile: clocks ramp up quickly and stay steady in
# games instead of swinging (which causes stutter). Boost is not capped.
ACTION=="add", SUBSYSTEM=="drm", KERNEL=="card[0-9]", DRIVERS=="amdgpu", RUN+="/bin/sh -c 'echo manual > /sys/class/drm/%k/device/power_dpm_force_performance_level && echo 1 > /sys/class/drm/%k/device/pp_power_profile_mode'"
