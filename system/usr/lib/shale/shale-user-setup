#!/bin/sh
# Per-user Shale defaults, run at every Plasma login.

# Keep libadwaita/GTK 4 apps in the KDE colour scheme: install Shale's colour mapping
# next to kde-gtk-config's colors.css and import it from gtk.css.
dir="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0"
mkdir -p "$dir"
cp -f /usr/share/shale/gtk-4.0/shale-adwaita.css "$dir/shale-adwaita.css"
# kde-gtk-config only writes colors.css when the colour scheme changes, so a new user
# starts with Shale Dark's (otherwise every colour above is undefined: transparent apps).
[ -s "$dir/colors.css" ] || cp /usr/share/shale/gtk-4.0/colors.css "$dir/colors.css"
[ -f "$dir/gtk.css" ] || printf "@import 'colors.css';\n" > "$dir/gtk.css"
[ -n "$(tail -c1 "$dir/gtk.css")" ] && echo >> "$dir/gtk.css"
grep -q "shale-adwaita.css" "$dir/gtk.css" ||
    printf "@import 'shale-adwaita.css';\n" >> "$dir/gtk.css"

# The Shale terminal prompt, loaded from ~/.bashrc.
rc="$HOME/.bashrc"
[ -f "$rc" ] || : > "$rc"
grep -q "/usr/share/shale/bashrc" "$rc" ||
    printf '\n# Shale terminal prompt\n[ -r /usr/share/shale/bashrc ] && . /usr/share/shale/bashrc\n' >> "$rc"

# The terminal and the login screen don't follow the colour scheme by themselves.
/usr/lib/shale/shale-match-theme

# Prefer colour accuracy over power efficiency on each screen, the first time it's seen
# (later changes in Display Settings are kept): the efficiency mode hands video to the
# GPU's overlay planes, which can make it flicker on some AMD cards.
seen="${XDG_CONFIG_HOME:-$HOME/.config}/shale/color-accuracy-outputs"
mkdir -p "${seen%/*}"
touch "$seen"
kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '/^Output:/ { print $3 }' |
while read -r out; do
    grep -qx "$out" "$seen" && continue
    kscreen-doctor "output.$out.colorPowerTradeoff.preferAccuracy" >/dev/null 2>&1 &&
        echo "$out" >> "$seen"
done

# Always the performance power profile: Shale prefers speed and low latency over saving power.
powerprofilesctl set performance 2>/dev/null

# Keep Flathub's app catalogue current for Bazaar (in the background; needs internet).
(flatpak update --system -y --noninteractive --appstream flathub >/dev/null 2>&1 &)

# Bazaar must not linger in the background (and so in the system tray) after its
# window is closed; Shale Update handles updates instead.
flatpak permission-set background background io.github.kolunmi.Bazaar no 2>/dev/null
exit 0
