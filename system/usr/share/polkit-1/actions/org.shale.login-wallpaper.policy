<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Shale Linux</vendor>
  <action id="org.shale.login-wallpaper">
    <description>Match the login screen wallpaper to your colour scheme</description>
    <message>Authentication is required to change the login screen wallpaper</message>
    <icon_name>preferences-desktop-wallpaper</icon_name>
    <!-- It only switches between Shale's light and dark wallpaper, so anyone sitting at
         the computer may do it without a password. -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/shale/shale-login-wallpaper</annotate>
  </action>
</policyconfig>
